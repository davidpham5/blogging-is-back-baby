---
permalink: /main-feed/feed.xml
eleventyExcludeFromCollections: true
---
{% set amplifyItems = collections.contentTypes | findBySlug('amplify') | values('items') %}
{% set feedItems = amplifyItems | mergeFeeds(raindrop.articles) | limit(100) %}<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en">
    <title type="text">Main Feed — {{ metadata.author.shortname or metadata.author.name }}</title>
    <subtitle type="text">StoryStream picks and turbocharged hyperlinks from David Chico Pham.</subtitle>

    <id>https://davidchicopham.com/main-feed/feed.xml</id>
    <link rel="alternate" type="text/html" href="{{ metadata.url }}" />
    <link rel="self" type="application/atom+xml" href="https://davidchicopham.com/main-feed/feed.xml" />

    <updated>{{ feedItems[0]._date | dateToFormat('iso') }}</updated>
    <author>
        <name>{{ metadata.author.name }}</name>
    </author>
    <generator uri="https://www.11ty.dev/">Eleventy.js</generator>

    {%- for item in feedItems %}
        {%- if item._feedType == 'amplify' %}
            {%- set post = item.post %}
            {%- set absolutePostUrl %}{{ post.url | url | absoluteUrl(metadata.url) }}{% endset %}
            <entry>
                <title>{{ post.data.title }}</title>
                <link href="{{ post.data.link or post.data.referringUri or post.data.canonical or absolutePostUrl }}"/>
                <updated>{{ post.date | dateToRfc3339 }}</updated>
                <id>{{ absolutePostUrl }}</id>
                <category term="storystream"/>
                <content type="html">
                    {{ post.templateContent | htmlToAbsoluteUrls(absolutePostUrl) }}
                </content>
            </entry>
        {%- else %}
            {%- set link = item.article %}
            <entry>
                <title>{{ link.title }}</title>
                <link href="{{ link.source_url }}"/>
                <updated>{{ link.date | dateToFormat('iso') }}</updated>
                <id>{{ link.source_url }}</id>
                <category term="turbolink"/>
                <content type="html">
                    <![CDATA[{% if link.note %}<p>{{ link.note }}</p>{% endif %}{% if link.summary %}<p>{{ link.summary }}</p>{% endif %}]]>
                </content>
            </entry>
        {%- endif %}
    {%- endfor %}
</feed>
